+    private void recordLogProb(String output, double lp) {
+        if (Double.isNaN(lp)) return;
+        Double old = hypLogProb.get(output);
+        if (old == null || lp > old) hypLogProb.put(output, lp);   // same text from several inputs: keep the most confident
+    }
+
+    private double logProbOf(String output) {
+        Double lp = hypLogProb.get(output);
+        return lp == null ? Double.NaN : lp;
+    }
+
+    /**
+     * Low-confidence gap (nats per token) between the most confident hypothesis among the candidates and the
+     * chosen one. Calibrated on the seed set (docs/eval/2026-11-26_jane-v7-logprob-seed.md): no chosen output
+     * whose validator verdict was clean exceeded it. NaN disables the flag.
+     */
+    static double LOW_CONFIDENCE_GAP = Double.NaN;
+
+    static boolean lowConfidence(Candidate chosen, List<Candidate> scored) {
+        if (Double.isNaN(LOW_CONFIDENCE_GAP) || Double.isNaN(chosen.logProb)) return false;
+        double top = Double.NEGATIVE_INFINITY;
+        for (Candidate c : scored) if (!Double.isNaN(c.logProb) && c.logProb > top) top = c.logProb;
+        return top - chosen.logProb > LOW_CONFIDENCE_GAP;
+    }
+
     static boolean better(Candidate a, Candidate b) {
         if (a.hard() != b.hard() && (a.hard() == 0 || b.hard() == 0)) return a.hard() < b.hard();
         if (a.hard() > 0 && b.hard() > 0) {
@@ -419,6 +462,9 @@ public final class JaNeTranslator {
             int sa = severity(a.issues), sb = severity(b.issues);
             if (sa != sb) return sa < sb;
             if (a.hard() != b.hard()) return a.hard() < b.hard();
+            // same severity and count: the decoder's own confidence breaks the tie when both are known
+            // (SourceContributionAnalyzer, spec 15 P1); the round-trip score stays the fallback
+            if (!Double.isNaN(a.logProb) && !Double.isNaN(b.logProb) && a.logProb != b.logProb) return a.logProb > b.logProb;
         }
         return a.score > b.score;
     }
