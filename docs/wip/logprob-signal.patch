diff --git a/app/src/main/java/nie/translator/rtranslator/jane/Backend.java b/app/src/main/java/nie/translator/rtranslator/jane/Backend.java
index ca43eec..0813e9e 100644
--- a/app/src/main/java/nie/translator/rtranslator/jane/Backend.java
+++ b/app/src/main/java/nie/translator/rtranslator/jane/Backend.java
@@ -22,4 +22,27 @@ public interface Backend {
     default List<String> translateNBestWide(String text, String srcLang, String tgtLang, int n, int beam) throws Exception {
         return translateNBest(text, srcLang, tgtLang, n);
     }
+
+    /** One hypothesis with its length-normalised log-probability (sum of token log-probs / tokens); NaN when unknown. */
+    final class Scored {
+        public final String text;
+        public final double logProb;
+        public Scored(String text, double logProb) { this.text = text; this.logProb = logProb; }
+    }
+
+    /** {@link #translateNBest} with the decoder's log-probability per hypothesis. Default: NaN (no signal). */
+    default List<Scored> translateNBestScored(String text, String srcLang, String tgtLang, int n) throws Exception {
+        return unscored(translateNBest(text, srcLang, tgtLang, n));
+    }
+
+    /** {@link #translateNBestWide} with log-probabilities. Default: NaN (no signal). */
+    default List<Scored> translateNBestWideScored(String text, String srcLang, String tgtLang, int n, int beam) throws Exception {
+        return unscored(translateNBestWide(text, srcLang, tgtLang, n, beam));
+    }
+
+    static List<Scored> unscored(List<String> hyps) {
+        List<Scored> out = new java.util.ArrayList<>();
+        for (String h : hyps) out.add(new Scored(h, Double.NaN));
+        return out;
+    }
 }
